# HALLMARK Environment Configuration
# Copy to .env and fill in your keys

# Required for live LLM - system works in demo mode without this
GEMINI_API_KEY=

# Database
DATABASE_URL=postgresql+asyncpg://localhost:5432/hallmark
DATABASE_URL_SYNC=postgresql://localhost:5432/hallmark

# Research providers (optional - demo mode without them)
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# Publishing (optional)
BUFFER_API_KEY=

# App
APP_ENV=development
APP_PORT=8000
